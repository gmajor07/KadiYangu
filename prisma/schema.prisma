generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  designs       Design[]
  orders        Order[]
  entitlements  Entitlement[]
  exports       ExportRecord[]
  events        Event[]
  auditLogs     AuditLog[]
  eventStaff    EventStaff[]
  organizations OrganizationMember[]
  ownedOrganizations Organization[]
  organizationInvitationsSent OrganizationInvitation[] @relation("InvitationSender")
  organizationBillingInitiated OrganizationBillingRecord[]
  betaGrants BetaGrant[]
  feedback Feedback[]
  contributionPaymentsRecorded ContributionPayment[]
}

// Shared, atomic throttling across Node workers; no Redis requirement.
model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum DesignStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}
enum OrderType {
  DESIGN_EXPORT
  TEMPLATE_PURCHASE
  EVENT_PACKAGE
}
enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentProvider {
  MIX_BY_YAS
  MPESA
  AIRTEL_MONEY
  CARD
  MANUAL_TEST
}
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}
enum EntitlementCapability {
  PREMIUM_EXPORT
}
enum PricingTier {
  FREE
  STANDARD
  PREMIUM
  CUSTOM
}

model EventCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  imageUrl    String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]

  @@index([isActive, sortOrder])
}

model Template {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String
  thumbnailUrl    String
  previewImageUrl String?
  categoryId      String
  category        EventCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPremium       Boolean             @default(false)
  /// Nullable during migration so existing records can be reviewed safely.
  pricingTier     PricingTier?
  // Whole currency units in Phase 2 (e.g. 5000 = TZS 5,000), never floats.
  price           Int?
  currency        String              @default("TZS") @db.VarChar(3)
  status          TemplateStatus      @default(DRAFT)
  isFeatured      Boolean             @default(false)
  isActive        Boolean             @default(true)
  orientation     TemplateOrientation @default(PORTRAIT)
  width           Int                 @default(1080)
  height          Int                 @default(1350)
  designData      Json
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  designs         Design[]

  @@index([categoryId, status, isActive])
  @@index([status, isActive, isFeatured, createdAt])
}

model Design {
  id           String              @id @default(cuid())
  userId       String
  templateId   String?
  organizationId String?
  name         String              @db.VarChar(160)
  designData   Json
  width        Int
  height       Int
  orientation  TemplateOrientation
  thumbnailUrl String?
  status       DesignStatus        @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders       Order[]
  exports      ExportRecord[]

  @@index([userId, status, updatedAt])
  @@index([templateId])
  @@index([organizationId])
  events       Event[]
}

enum EventStatus {
 DRAFT
 PUBLISHED
 ARCHIVED
}
enum RsvpStatus {
 ATTENDING
 NOT_ATTENDING
 MAYBE
}
enum ContributionPledgeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}
enum ContributionPaymentMethod {
  CASH
  MPESA
  MIXX_BY_YAS
  AIRTEL_MONEY
  BANK_TRANSFER
  OTHER
}
enum ContributionVerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVERSED
}
enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}
enum MessageCampaignStatus {
  DRAFT
  READY
  CANCELLED
}
enum MessageDeliveryStatus {
  NOT_SENT
  QUEUED
  SENT
  DELIVERED
  FAILED
}
enum MessageConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

model Event {
  id String @id @default(cuid())
  userId String
  designId String
  organizationId String?
  title String @db.VarChar(160)
  slug String @unique @db.VarChar(180)
  eventType String @db.VarChar(60)
  eventDate DateTime
  startTime String? @db.VarChar(10)
  endTime String? @db.VarChar(10)
  venue String? @db.VarChar(160)
  locationText String? @db.VarChar(240)
  latitude Float?
  longitude Float?
  description String? @db.VarChar(2000)
  status EventStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  organization Organization? @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  design Design @relation(fields:[designId], references:[id], onDelete:Restrict)
  responses Rsvp[]
  website EventWebsite?
  schedule EventScheduleItem[]
  gallery EventGalleryItem[]
  guests Guest[]
  orders Order[]
  guestPassPurchases GuestPassPurchase[]
  guestPasses GuestPass[]
  staff EventStaff[]
  contributors EventContributor[]
  messageTemplates MessageTemplate[]
  messageCampaigns MessageCampaign[]
  messageConsents MessageConsent[]
  messageLogs MessageLog[]
  @@index([userId,status])
  @@index([organizationId,status])
}

enum OrganizationType {
 AGENCY
 RESELLER
 PLANNER
 BUSINESS
}
enum OrganizationStatus {
 ACTIVE
 SUSPENDED
 ARCHIVED
}
enum OrganizationMemberRole {
 OWNER
 ADMIN
 MANAGER
 EDITOR
 SCANNER
 BILLING
}
enum OrganizationMemberStatus {
 INVITED
 ACTIVE
 SUSPENDED
 REMOVED
}
model Organization {
 id String @id @default(cuid())
 name String @db.VarChar(160)
 slug String @unique @db.VarChar(180)
 type OrganizationType @default(AGENCY)
 status OrganizationStatus @default(ACTIVE)
 ownerUserId String
 owner User @relation(fields:[ownerUserId], references:[id], onDelete:Restrict)
 members OrganizationMember[]
 invitations OrganizationInvitation[]
 designs Design[]
 events Event[]
 subscriptions OrganizationSubscription[]
 billingRecords OrganizationBillingRecord[]
 betaGrants BetaGrant[]
 feedback Feedback[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([ownerUserId,status])
}
model OrganizationMember {
 id String @id @default(cuid())
 organizationId String
 userId String
 role OrganizationMemberRole @default(EDITOR)
 status OrganizationMemberStatus @default(ACTIVE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([organizationId,userId])
 @@index([userId,status])
}
model OrganizationInvitation {
 id String @id @default(cuid())
 organizationId String
 email String @db.VarChar(254)
 role OrganizationMemberRole @default(EDITOR)
 tokenHash String @unique @db.VarChar(64)
 invitedByUserId String
 expiresAt DateTime
 acceptedAt DateTime?
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
 invitedBy User @relation("InvitationSender", fields:[invitedByUserId], references:[id], onDelete:Restrict)
 @@index([organizationId,email,expiresAt])
}

enum SubscriptionPlanCode {
 STARTER
 BUSINESS
 ENTERPRISE
}
enum BillingInterval {
 MONTHLY
 ANNUAL
}
enum OrganizationSubscriptionStatus {
 PENDING
 ACTIVE
 EXPIRED
 CANCELLED
}
enum OrganizationBillingStatus {
 PENDING
 VERIFIED
 FAILED
 CANCELLED
}
model SubscriptionPlan {
 id String @id @default(cuid())
 code SubscriptionPlanCode
 name String @db.VarChar(120)
 description String? @db.VarChar(500)
 monthlyAmount Int
 annualAmount Int
 currency String @default("TZS") @db.VarChar(3)
 eventLimit Int?
 designLimit Int?
 memberLimit Int?
 guestPassLimit Int?
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 subscriptions OrganizationSubscription[]
 billingRecords OrganizationBillingRecord[]
 @@unique([code])
 @@index([isActive,code])
}
model OrganizationSubscription {
 id String @id @default(cuid())
 organizationId String
 planId String
 status OrganizationSubscriptionStatus @default(PENDING)
 interval BillingInterval
 planNameSnapshot String @db.VarChar(120)
 amountSnapshot Int
 currencySnapshot String @default("TZS") @db.VarChar(3)
 periodStart DateTime?
 periodEnd DateTime?
 renewsAt DateTime?
 cancelAtPeriodEnd Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
 plan SubscriptionPlan @relation(fields:[planId], references:[id], onDelete:Restrict)
 billingRecords OrganizationBillingRecord[]
 @@index([organizationId,status,periodEnd])
 @@index([planId,createdAt])
}
model OrganizationBillingRecord {
 id String @id @default(cuid())
 organizationId String
 planId String
 subscriptionId String?
 initiatedByUserId String
 idempotencyKey String @unique @db.VarChar(120)
 status OrganizationBillingStatus @default(PENDING)
 planNameSnapshot String @db.VarChar(120)
 interval BillingInterval
 amount Int
 currency String @default("TZS") @db.VarChar(3)
 providerReference String?
 verifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
 plan SubscriptionPlan @relation(fields:[planId], references:[id], onDelete:Restrict)
 subscription OrganizationSubscription? @relation(fields:[subscriptionId], references:[id], onDelete:SetNull)
 initiatedBy User @relation(fields:[initiatedByUserId], references:[id], onDelete:Restrict)
 @@unique([providerReference])
 @@index([organizationId,status,createdAt])
}


model BetaConfiguration {
 id String @id @default("default")
 enabled Boolean @default(false)
 personalExpiresAt DateTime?
 organizationExpiresAt DateTime?
 personalDesignLimit Int @default(3)
 personalEventLimit Int @default(1)
 personalGuestPassLimit Int @default(50)
 organizationDesignLimit Int @default(25)
 organizationEventLimit Int @default(10)
 organizationGuestPassLimit Int @default(500)
 updatedAt DateTime @updatedAt
}
model BetaGrant {
 id String @id @default(cuid())
 userId String?
 organizationId String?
 grantType String @default("BETA_GRANT") @db.VarChar(30)
 expiresAt DateTime
 designLimit Int @default(0)
 eventLimit Int @default(0)
 guestPassLimit Int @default(0)
 designsUsed Int @default(0)
 eventsUsed Int @default(0)
 guestPassesUsed Int @default(0)
 createdAt DateTime @default(now())
 user User? @relation(fields:[userId], references:[id], onDelete:Restrict)
 organization Organization? @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  guestPassPurchases GuestPassPurchase[]
 @@unique([userId,grantType])
 @@unique([organizationId,grantType])
 @@index([expiresAt])
}
model Feedback {
 id String @id @default(cuid())
 userId String?
 organizationId String?
 rating Int
 message String @db.VarChar(2000)
 contactAllowed Boolean @default(false)
 status String @default("OPEN") @db.VarChar(20)
 createdAt DateTime @default(now())
 reviewedAt DateTime?
 user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
 organization Organization? @relation(fields:[organizationId], references:[id], onDelete:SetNull)
 @@index([status,createdAt])
 @@index([userId,createdAt])
}

enum GuestInvitationStatus {
 NOT_SENT
 SENT
 DELIVERED
 FAILED
}
model Guest {
  id String @id @default(cuid())
  eventId String
  name String @db.VarChar(160)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(30)
  category String? @db.VarChar(80)
  notes String? @db.VarChar(1000)
  invitationCode String @unique @db.VarChar(64)
  plusOneAllowed Boolean @default(false)
  maxGuests Int @default(1)
  invitationStatus GuestInvitationStatus @default(NOT_SENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  rsvps Rsvp[]
  contributors EventContributor[]
  messageRecipients MessageRecipient[]
  messageConsents MessageConsent[]
  @@index([eventId, name])
  @@index([eventId, invitationStatus])
}

model EventContributor {
  id String @id @default(cuid())
  eventId String
  guestId String?
  fullName String @db.VarChar(160)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(254)
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  guest Guest? @relation(fields:[guestId], references:[id], onDelete:SetNull)
  pledges ContributionPledge[]
  payments ContributionPayment[]
  messageRecipients MessageRecipient[]
  messageConsents MessageConsent[]
  @@unique([eventId, guestId])
  @@index([eventId, fullName])
}

model ContributionPledge {
  id String @id @default(cuid())
  contributorId String
  amount Int
  dueDate DateTime?
  notes String? @db.VarChar(1000)
  status ContributionPledgeStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contributor EventContributor @relation(fields:[contributorId], references:[id], onDelete:Cascade)
  payments ContributionPayment[]
  @@index([contributorId, status])
}

model ContributionPayment {
  id String @id @default(cuid())
  contributorId String
  pledgeId String?
  amount Int
  method ContributionPaymentMethod
  paymentDate DateTime @default(now())
  referenceNumber String? @db.VarChar(120)
  verificationStatus ContributionVerificationStatus @default(PENDING)
  recordedByUserId String
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contributor EventContributor @relation(fields:[contributorId], references:[id], onDelete:Cascade)
  pledge ContributionPledge? @relation(fields:[pledgeId], references:[id], onDelete:SetNull)
  recordedBy User @relation(fields:[recordedByUserId], references:[id], onDelete:Restrict)
  @@index([contributorId, verificationStatus])
  @@index([pledgeId])
}

model MessageTemplate {
  id String @id @default(cuid())
  eventId String
  name String @db.VarChar(120)
  channel MessageChannel
  body String @db.VarChar(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  campaigns MessageCampaign[]
  @@index([eventId, channel])
}
model MessageCampaign {
  id String @id @default(cuid())
  eventId String
  templateId String?
  name String @db.VarChar(160)
  channel MessageChannel
  status MessageCampaignStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  template MessageTemplate? @relation(fields:[templateId], references:[id], onDelete:SetNull)
  recipients MessageRecipient[]
  logs MessageLog[]
  @@index([eventId, status, createdAt])
}
enum SmsJobState {
  NONE
  PENDING
  PROCESSING
  RETRY_WAIT
  COMPLETE
  FAILED
  UNCERTAIN
}

model MessageRecipient {
  smsJobState SmsJobState @default(NONE)
  smsMode String? @db.VarChar(8)
  smsIdempotencyKey String? @unique @db.VarChar(100)
  smsAttempts Int @default(0)
  smsNextAttemptAt DateTime?
  smsLockedAt DateTime?
  smsErrorKind String? @db.VarChar(24)
  smsFailureReason String? @db.VarChar(500)
  smsProviderRequestId String? @db.VarChar(100)
  smsDeliveryCheckedAt DateTime?

  id String @id @default(cuid())
  campaignId String
  guestId String?
  contributorId String?
  destination String @db.VarChar(254)
  renderedBody String @db.VarChar(5000)
  status MessageDeliveryStatus @default(NOT_SENT)
  createdAt DateTime @default(now())
  campaign MessageCampaign @relation(fields:[campaignId], references:[id], onDelete:Restrict)
  guest Guest? @relation(fields:[guestId], references:[id], onDelete:SetNull)
  contributor EventContributor? @relation(fields:[contributorId], references:[id], onDelete:SetNull)
  logs MessageLog[]
  @@unique([campaignId, destination])
  @@index([campaignId, status])
  @@index([smsJobState, smsNextAttemptAt])
}
model MessageLog {
  providerRequestId String? @db.VarChar(100)
  id String @id @default(cuid())
  eventId String
  campaignId String
  recipientId String?
  channel MessageChannel
  status MessageDeliveryStatus
  errorMessage String? @db.VarChar(500)
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveredAt DateTime?
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  campaign MessageCampaign @relation(fields:[campaignId], references:[id], onDelete:Restrict)
  recipient MessageRecipient? @relation(fields:[recipientId], references:[id], onDelete:SetNull)
  @@index([eventId, createdAt])
  @@index([campaignId, status])
}
model MessageConsent {
  id String @id @default(cuid())
  eventId String
  guestId String?
  contributorId String?
  channel MessageChannel
  status MessageConsentStatus @default(UNKNOWN)
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  guest Guest? @relation(fields:[guestId], references:[id], onDelete:SetNull)
  contributor EventContributor? @relation(fields:[contributorId], references:[id], onDelete:SetNull)
  @@unique([eventId, guestId, contributorId, channel])
  @@index([eventId, channel, status])
}

model EventWebsite {
  id String @id @default(cuid())
  eventId String @unique
  theme String @default("ELEGANT")
  sectionOrder Json?
  visibleSections Json?
  people Json?
  introductionTitle String?
  introductionContent String?
  storyTitle String?
  storyContent String?
  storyImage String?
  giftTitle String?
  giftDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
}
model EventScheduleItem {
  id String @id @default(cuid())
  eventId String
  title String @db.VarChar(160)
  timeText String? @db.VarChar(30)
  details String? @db.VarChar(500)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([eventId, sortOrder])
}
model EventGalleryItem {
  id String @id @default(cuid())
  eventId String
  imageUrl String
  altText String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([eventId, sortOrder])
}

model Rsvp {
  id String @id @default(cuid())
  eventId String
  guestId String?
  guestName String @db.VarChar(120)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(254)
  status RsvpStatus
  guestCount Int @default(1)
  message String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  guest Guest? @relation(fields:[guestId], references:[id], onDelete:SetNull)
  @@index([eventId,createdAt])
  @@index([eventId,email])
  @@index([eventId,phone])
  @@index([guestId])
  @@unique([eventId,guestId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  orderNumber  String      @unique
  type         OrderType
  status       OrderStatus @default(PENDING)
  currency     String      @default("TZS") @db.VarChar(3)
  subtotal     Int
  total        Int
  designId     String?
  eventId      String?
  paidAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  design       Design?     @relation(fields: [designId], references: [id], onDelete: SetNull)
  event        Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  payments     Payment[]
  entitlements Entitlement[]
  items        OrderItem[]
  guestPassPurchase GuestPassPurchase?
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([eventId, createdAt])
}

model PricingRule {
  id String @id @default(cuid())
  key String @unique @db.VarChar(80)
  tier PricingTier
  amount Int?
  minQuantity Int @default(1)
  maxQuantity Int?
  discountPercent Int?
  currency String @default("TZS") @db.VarChar(3)
  isActive Boolean @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tier,isActive,effectiveFrom])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  kind String @db.VarChar(60)
  description String @db.VarChar(240)
  quantity Int
  unitAmount Int
  totalAmount Int
  currency String @default("TZS") @db.VarChar(3)
  sourceTemplateId String?
  sourceDesignId String?
  metadata Json?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  @@index([orderId])
}
model GuestPassPurchase {
  id String @id @default(cuid())
  orderId String? @unique
  betaGrantId String?
  eventId String
  quantityPurchased Int
  quantityIssued Int @default(0)
  quantityRemaining Int
  unitAmount Int
  totalAmount Int
  currency String @default("TZS") @db.VarChar(3)
  status String @default("PENDING") @db.VarChar(20)
  idempotencyKey String @unique @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order? @relation(fields:[orderId], references:[id], onDelete:Cascade)
  betaGrant BetaGrant? @relation(fields:[betaGrantId], references:[id], onDelete:Restrict)
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  @@index([eventId,status,createdAt])
  @@index([betaGrantId,createdAt])
  passes GuestPass[]
}

enum GuestPassStatus {
  ACTIVE
  CHECKED_IN
  REVOKED
}
model EventStaff {
  id String @id @default(cuid())
  eventId String
  userId String
  role String @default("SCANNER") @db.VarChar(20)
  createdAt DateTime @default(now())
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([eventId,userId])
}
model GuestPass {
  id String @id @default(cuid())
  eventId String
  purchaseId String
  tokenHash String @unique @db.VarChar(64)
  guestName String? @db.VarChar(160)
  guestEmail String? @db.VarChar(254)
  guestPhone String? @db.VarChar(30)
  status GuestPassStatus @default(ACTIVE)
  replacementRevision Int @default(0)
  issuedAt DateTime @default(now())
  checkedInAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  purchase GuestPassPurchase @relation(fields:[purchaseId], references:[id], onDelete:Cascade)
  checkIns CheckIn[]
  @@index([eventId,status])
  @@index([purchaseId])
}
model CheckIn {
  id String @id @default(cuid())
  passId String
  eventId String
  scannerUserId String
  result String @db.VarChar(30)
  createdAt DateTime @default(now())
  pass GuestPass @relation(fields:[passId], references:[id], onDelete:Cascade)
  @@index([eventId,createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  action String @db.VarChar(80)
  entityType String @db.VarChar(80)
  entityId String? @db.VarChar(120)
  beforeData Json?
  afterData Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields:[actorUserId], references:[id], onDelete:SetNull)
  @@index([actorUserId,createdAt])
  @@index([entityType,entityId,createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerReference String?
  amount            Int
  currency          String          @default("TZS") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([provider, providerReference])
  @@index([orderId, status])
}

model Entitlement {
  id           String                @id @default(cuid())
  userId       String
  orderId      String
  resourceType String
  resourceId   String
  capability   EntitlementCapability
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([userId, resourceType, resourceId, capability])
  @@index([userId, capability])
}

model ExportRecord {
  id          String   @id @default(cuid())
  userId      String
  designId    String
  format      String   @db.VarChar(4)
  quality     String   @db.VarChar(20)
  watermarked Boolean
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([designId, createdAt])
}

model HeroSlide {
  placement String @default("CARD") @db.VarChar(20)
  id        String   @id @default(cuid())
  imageUrl  String   @db.VarChar(500)
  altText   String   @db.VarChar(200)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, sortOrder])
  @@index([placement, isActive, sortOrder])
}
