generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  designs       Design[]
  orders        Order[]
  entitlements  Entitlement[]
  exports       ExportRecord[]
  events        Event[]
}

// Shared, atomic throttling across Node workers; no Redis requirement.
model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum DesignStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}
enum OrderType {
  DESIGN_EXPORT
  TEMPLATE_PURCHASE
  EVENT_PACKAGE
}
enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}
enum PaymentProvider {
  MIX_BY_YAS
  MPESA
  AIRTEL_MONEY
  CARD
  MANUAL_TEST
}
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}
enum EntitlementCapability {
  PREMIUM_EXPORT
}

model EventCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  imageUrl    String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]

  @@index([isActive, sortOrder])
}

model Template {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String
  thumbnailUrl    String
  previewImageUrl String?
  categoryId      String
  category        EventCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPremium       Boolean             @default(false)
  // Whole currency units in Phase 2 (e.g. 5000 = TZS 5,000), never floats.
  price           Int?
  currency        String              @default("TZS") @db.VarChar(3)
  status          TemplateStatus      @default(DRAFT)
  isFeatured      Boolean             @default(false)
  isActive        Boolean             @default(true)
  orientation     TemplateOrientation @default(PORTRAIT)
  width           Int                 @default(1080)
  height          Int                 @default(1350)
  designData      Json
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  designs         Design[]

  @@index([categoryId, status, isActive])
  @@index([status, isActive, isFeatured, createdAt])
}

model Design {
  id           String              @id @default(cuid())
  userId       String
  templateId   String?
  name         String              @db.VarChar(160)
  designData   Json
  width        Int
  height       Int
  orientation  TemplateOrientation
  thumbnailUrl String?
  status       DesignStatus        @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orders       Order[]
  exports      ExportRecord[]

  @@index([userId, status, updatedAt])
  @@index([templateId])
  events       Event[]
}

enum EventStatus {
 DRAFT
 PUBLISHED
 ARCHIVED
}
enum RsvpStatus {
 ATTENDING
 NOT_ATTENDING
 MAYBE
}

model Event {
  id String @id @default(cuid())
  userId String
  designId String
  title String @db.VarChar(160)
  slug String @unique @db.VarChar(180)
  eventType String @db.VarChar(60)
  eventDate DateTime
  startTime String? @db.VarChar(10)
  endTime String? @db.VarChar(10)
  venue String? @db.VarChar(160)
  locationText String? @db.VarChar(240)
  latitude Float?
  longitude Float?
  description String? @db.VarChar(2000)
  status EventStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  design Design @relation(fields:[designId], references:[id], onDelete:Restrict)
  responses Rsvp[]
  website EventWebsite?
  schedule EventScheduleItem[]
  gallery EventGalleryItem[]
  guests Guest[]
  @@index([userId,status])
}

enum GuestInvitationStatus {
 NOT_SENT
 SENT
 DELIVERED
 FAILED
}
model Guest {
  id String @id @default(cuid())
  eventId String
  name String @db.VarChar(160)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(30)
  category String? @db.VarChar(80)
  notes String? @db.VarChar(1000)
  invitationCode String @unique @db.VarChar(64)
  plusOneAllowed Boolean @default(false)
  maxGuests Int @default(1)
  invitationStatus GuestInvitationStatus @default(NOT_SENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  rsvps Rsvp[]
  @@index([eventId, name])
  @@index([eventId, invitationStatus])
}

model EventWebsite {
  id String @id @default(cuid())
  eventId String @unique
  theme String @default("ELEGANT")
  sectionOrder Json?
  visibleSections Json?
  people Json?
  introductionTitle String?
  introductionContent String?
  storyTitle String?
  storyContent String?
  storyImage String?
  giftTitle String?
  giftDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
}
model EventScheduleItem {
  id String @id @default(cuid())
  eventId String
  title String @db.VarChar(160)
  timeText String? @db.VarChar(30)
  details String? @db.VarChar(500)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([eventId, sortOrder])
}
model EventGalleryItem {
  id String @id @default(cuid())
  eventId String
  imageUrl String
  altText String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  @@index([eventId, sortOrder])
}

model Rsvp {
  id String @id @default(cuid())
  eventId String
  guestId String?
  guestName String @db.VarChar(120)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(254)
  status RsvpStatus
  guestCount Int @default(1)
  message String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  guest Guest? @relation(fields:[guestId], references:[id], onDelete:SetNull)
  @@index([eventId,createdAt])
  @@index([eventId,email])
  @@index([eventId,phone])
  @@index([guestId])
  @@unique([eventId,guestId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  orderNumber  String      @unique
  type         OrderType
  status       OrderStatus @default(PENDING)
  currency     String      @default("TZS") @db.VarChar(3)
  subtotal     Int
  total        Int
  designId     String?
  paidAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  design       Design?     @relation(fields: [designId], references: [id], onDelete: SetNull)
  payments     Payment[]
  entitlements Entitlement[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerReference String?
  amount            Int
  currency          String          @default("TZS") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([provider, providerReference])
  @@index([orderId, status])
}

model Entitlement {
  id           String                @id @default(cuid())
  userId       String
  orderId      String
  resourceType String
  resourceId   String
  capability   EntitlementCapability
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([userId, resourceType, resourceId, capability])
  @@index([userId, capability])
}

model ExportRecord {
  id          String   @id @default(cuid())
  userId      String
  designId    String
  format      String   @db.VarChar(4)
  quality     String   @db.VarChar(20)
  watermarked Boolean
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([designId, createdAt])
}
