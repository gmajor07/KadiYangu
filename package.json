{
  "name": "kadiyangu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:cpanel": "NODE_ENV=production node server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:seed": "node scripts/seed-demo.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
