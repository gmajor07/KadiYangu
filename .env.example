# PostgreSQL database owned by the application migration user; URL-encode passwords.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kadiyangu?schema=public"
# Generate with: openssl rand -base64 32. Never use the placeholder.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Keep false on staging. Set true only after privacy/terms and launch review.
SITE_INDEXABLE="false"
