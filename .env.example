# PostgreSQL database owned by the application migration user; URL-encode passwords.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kadiyangu?schema=public"
# Generate with: openssl rand -base64 32. Never use the placeholder.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OAuth providers are optional. Create credentials in Google/Facebook developer consoles.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Premium Export price in whole TZS units. Required in production.
PREMIUM_EXPORT_PRICE="5000"
# Development-only simulated payments. Keep false in production.
ENABLE_TEST_PAYMENTS="false"
# Keep false on staging. Set true only after privacy/terms and launch review.
SITE_INDEXABLE="false"
# Merchant number shown only when ENABLE_TEST_PAYMENTS=true.
DEMO_PAYMENT_MERCHANT_NUMBER="123456"

# Beem SMS API credentials (server-only). Use an approved active Sender ID.
BEEM_API_KEY=""
BEEM_API_SECRET=""
BEEM_SENDER_ID=""
# Phase 7E.4 PREPARED. Defaults cannot send live SMS, even with credentials.
BEEM_SENDER_APPROVED="false"
SMS_DISPATCH_MODE="disabled"
SMS_MOCK_DISPATCH_ENABLED="false"

# Optional stable server-only key (32+ random characters) for encrypted guest pass retrieval.
# If empty, a separate key is derived from AUTH_SECRET. Keep the chosen secret stable:
# changing it requires deliberate QR replacement for previously encrypted passes.
ENTRY_PASS_ENCRYPTION_KEY=""
